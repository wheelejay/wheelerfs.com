# Copy to backend/.env for local testing. On Render, set these under
# the service's Environment tab instead.
RESEND_API_KEY=your-resend-api-key

# Optional. Defaults to Resend's test sender, which only delivers to the
# Resend account owner. After verifying wheelerfs.com in Resend, set:
# CONTACT_FROM=Wheeler Food Safety <contact@wheelerfs.com>
# CONTACT_TO=jordan@wheelerfs.com

# Website chat assistant (required for /api/chat). Create a key at
# console.anthropic.com and set a monthly spend limit there.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: model and daily request cap
# CHAT_MODEL=claude-opus-5-5
# CHAT_DAILY_LIMIT=100
